# Discord channel webhook. Create it in Channel Settings > Integrations > Webhooks.
DISCORD_WEBHOOK_URL=

# Publishing remains disabled until a valid webhook URL is present.
PUBLISH_ENABLED=true

# SV Aich on FUSSBALL.DE.
FUSSBALL_CLUB_ID=00ES8GNA1O000099VV0AG08LVUPGND5I
FUSSBALL_CLUB_NAME=SV Aich

# A fixture is included when its FUSSBALL.DE venue contains any semicolon-separated term.
VENUE_MATCH_TERMS=Sportplatz Aich;Heideweg 60;72631 Aichtal
VENUE_DISPLAY_NAME=Sportplatz Aich

# Scheduling and output limits.
LOOKAHEAD_DAYS=365
SYNC_INTERVAL_MINUTES=360
MAX_EVENTS=25
TIMEZONE=Europe/Berlin

# Local status service. Keep this on loopback outside Docker.
STATUS_HOST=127.0.0.1
STATUS_PORT=8781

# TSV Korntal FPV calendar webhooks. Use one Discord webhook per text channel.
KORNTAL_WHOOP_WEBHOOK_URL=
KORNTAL_3_5_WEBHOOK_URL=
KORNTAL_RACE_WEBHOOK_URL=

